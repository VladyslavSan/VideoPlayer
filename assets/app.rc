// Windows resources: the app icon (GPUI loads icon id 1 for its windows)
// and the version details Explorer shows in the file's properties.
// build.rs fills in the @...@ placeholders (version from Cargo.toml).
1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Video Player"
            VALUE "ProductName", "Video Player"
            VALUE "FileVersion", "@VERSION@"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "OriginalFilename", "video-player.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
